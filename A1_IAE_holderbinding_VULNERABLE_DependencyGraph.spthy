     Hon_St2( $Wid, $CI, ~sid, ~skH, pkH, authSess, nonce ), In( AT ),
     Fr( ~skE )
     ]
    --[ Hon_CredReq( $Wid, $CI, ~sid, pkH ) ]->
     [
     Hon_St3( $Wid, $CI, ~sid, ~skE, pk(~skE), pkH ),
     Out( <'cred-req', AT, pkH, sign(<'oid4vci-proof', $CI, pkH>, ~skH), 
           pk(~skE)>
     )
     ]
  */

rule (modulo E) Hon_Client_RecvCred[color=#bfdbfe, role='Wallet']:
   [
   Hon_St3( $Wid, $CI, ~sid, ~skE, pk(~skE), pkH_cred ),
   In( penc(<'cred-resp', cred>, pk(~skE), rResp) )
   ]
  --[
  WalletObtained( $Wid, $CI, pkH_cred, cred ), Finish( $Wid, $CI, ~sid )
  ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction Restr_CI_Credential_Endpoint_1:
  "∀ x #NOW. (Restr_CI_Credential_Endpoint_1( x ) @ #NOW) ⇒ (x = true)"
