/*
-DVULNERABLE
*/

theory OID4VCI_A1

begin

// Function signature and definition of the equational theory E

functions: aToken/3[private,constructor], fst/1, h/1, pair/2, pdec/2,
           penc/3, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    pdec(penc(m, pk(k), r), k) = m,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

tactic: a1_witness_tactic
presort: C
prio: {id}
  regex"CI_Issued\("
  regex"CI_Accepted_Presentation\("
  regex"Victim_Presented\("
  regex"AdversaryKey\("
  regex"!CI_Authorized"
  regex"!CI_IAE_Pending\("
deprio: {id}
  regex"!KU\(~ltkCI"
  regex"!KU\(~skH"
  regex"!KU\(~"
tactic: a1_continuity_tactic
presort: C
prio: {id}
  regex"CI_Issued\("
  regex"CI_Accepted_Presentation\("
  regex"Victim_Presented\("
  regex"Victim_Committed\("
  regex"Reveal_HolderKey\("
  regex"!CI_Authorized"
  regex"!CI_IAE_Pending\("
deprio: {id}
  regex"!KU\(~ltkCI"
  regex"!KU\(~skH"
  regex"!KU\(~"
tactic: a1_impersonation_tactic
presort: C
prio: {id}
  regex"CI_Issued\("
  regex"AdversaryKey\("
  regex"CI_Accepted_Presentation\("
  regex"Victim_Presented\("
  regex"Victim_Committed\("
  regex"!CI_Authorized"
  regex"!CI_IAE_Pending\("
deprio: {id}
  regex"!KU\(~ltkCI"
  regex"!KU\(~skH"
  regex"!KU\(~"

macros: iarAud( CI ) =  <'iar', CI>,
        presReqPayload( CI, nonce ) =  <'openid4vp-request', CI, iarAud(CI), 
                                        nonce>,
        presReqSigned( CI, nonce, ltkCI ) =  <presReqPayload(CI, nonce), 
                                              sign(presReqPayload(CI, nonce), ltkCI)>,
        prereqPayload( PI, sub, pkH ) =  <'prereq-vc', PI, sub, pkH>,
        prereqVC( PI, sub, pkH, ltkPI ) =  sign(prereqPayload(PI, sub, pkH),
                                                ltkPI),
        kbPayload( CI, nonce ) =  <'kb-jwt', iarAud(CI), nonce>,
        kbProof( CI, nonce, skH ) =  sign(kbPayload(CI, nonce), skH),
        kbPayloadTx( CI, nonce, cmt ) =  <'kb-jwt-tx', iarAud(CI), nonce, cmt>,
        kbProofTx( CI, nonce, cmt, skH ) =  sign(kbPayloadTx(CI, nonce, cmt),
                                                 skH),
        keyProofPayload( CI, pkH ) =  <'oid4vci-proof', CI, pkH>,
        keyProofJWT( CI, pkH, skH ) =  sign(keyProofPayload(CI, pkH), skH),
        keyProofPayloadN( CI, pkH, nonce ) =  <'oid4vci-proof-n', CI, pkH, nonce
                                              >,
        keyProofJWTN( CI, pkH, nonce, skH ) =  sign(keyProofPayloadN(CI, pkH,
                                                                     nonce),
                                                    skH),
        credPayload( CI, sub, pkH ) =  <'credential', CI, sub, pkH>,
        credentialSig( CI, sub, pkH, ltkCI ) =  sign(credPayload(CI, sub, pkH),
                                                     ltkCI)

predicate: HonestCI( CI )<=>¬(∃ #r. Reveal_CI( CI ) @ #r)

predicate: NoHolderKeyLeak( Wid, pkH )<=>¬(∃ #r. Reveal_HolderKey( Wid, pkH ) @ #r)

restriction Eq:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction OnlyOnceV:
  "∀ x #i #j. ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ x #i #j. ((OnlyOnceV( x ) @ #i) ∧ (OnlyOnceV( x ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Register_CI[color=#fef3c7, role='Setup']:
   [ Fr( ~ltkCI ) ]
  --[
  Register_CI( $CI ), CIKey( $CI, ~ltkCI ), OnlyOnceV( <'reg-ci', $CI> )
  ]->
   [ !Ltk_CI( $CI, ~ltkCI ), !Pk_CI( $CI, pk(~ltkCI) ), Out( pk(~ltkCI) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_PI[color=#fef3c7, role='Setup']:
   [ Fr( ~ltkPI ) ]
  --[ Register_PI( $PI ), OnlyOnceV( <'reg-pi', $PI> ) ]->
   [ !Ltk_PI( $PI, ~ltkPI ), !Pk_PI( $PI, pk(~ltkPI) ), Out( pk(~ltkPI) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Issue_Prerequisite_VC[color=#fef3c7, role='Setup']:
   [ Fr( ~skH ), !Ltk_PI( $PI, ~ltkPI ) ]
  --[
  VictimKeyFresh( $Wid, ~skH, pk(~skH) ),
  PrereqIssued( $PI, $Wid, $sub, pk(~skH) )
  ]->
   [
   !Victim_PrereqVC( $Wid, $PI, $sub, ~skH, pk(~skH),
                     prereqVC($PI, $sub, pk(~skH), ~ltkPI)
   ),
   !StoredVictimHolderKey( $Wid, ~skH, pk(~skH) )
   ]

  /*
  rule (modulo AC) Issue_Prerequisite_VC[color=#fef3c7, role='Setup']:
     [ Fr( ~skH ), !Ltk_PI( $PI, ~ltkPI ) ]
    --[
    VictimKeyFresh( $Wid, ~skH, pk(~skH) ),
    PrereqIssued( $PI, $Wid, $sub, pk(~skH) )
    ]->
     [
     !Victim_PrereqVC( $Wid, $PI, $sub, ~skH, pk(~skH),
                       sign(<'prereq-vc', $PI, $sub, pk(~skH)>, ~ltkPI)
     ),
     !StoredVictimHolderKey( $Wid, ~skH, pk(~skH) )
     ]
  */

rule (modulo E) Adversary_Wallet_Key[color=#fecaca, role='Adv']:
   [ Fr( ~skAdv ) ] --[ AdversaryKey( pk(~skAdv) ) ]-> [ Out( ~skAdv ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_CI_Ltk[color=#fecaca, role='Adv']:
   [ !Ltk_CI( $CI, ~ltkCI ) ] --[ Reveal_CI( $CI ) ]-> [ Out( ~ltkCI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_VictimHolderKey[color=#fecaca, role='Adv']:
   [ !StoredVictimHolderKey( $Wid, ~skH, pkH ) ]
  --[ Reveal_HolderKey( $Wid, pkH ) ]->
   [ Out( ~skH ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CI_IAE_Require_Presentation[color=#fef9c3, role='CI']:
   [
   In( <'iae-init', $CI> ), !Ltk_CI( $CI, ~ltkCI ), Fr( ~authSess ),
   Fr( ~nonce )
   ]
  --[ CI_IAE_Start( $CI, ~authSess, ~nonce ) ]->
   [
   !CI_IAE_Pending( $CI, ~authSess, ~nonce ),
   Out( <'iae-require-interaction', ~authSess, 
         presReqSigned($CI, ~nonce, ~ltkCI)>
   )
   ]

  /*
  rule (modulo AC) CI_IAE_Require_Presentation[color=#fef9c3, role='CI']:
     [
     In( <'iae-init', $CI> ), !Ltk_CI( $CI, ~ltkCI ), Fr( ~authSess ),
     Fr( ~nonce )
     ]
    --[ CI_IAE_Start( $CI, ~authSess, ~nonce ) ]->
     [
     !CI_IAE_Pending( $CI, ~authSess, ~nonce ),
     Out( <'iae-require-interaction', ~authSess, 
           <'openid4vp-request', $CI, <'iar', $CI>, ~nonce>, 
           sign(<'openid4vp-request', $CI, <'iar', $CI>, ~nonce>, ~ltkCI)>
     )
     ]
  */

restriction Restr_CI_IAE_Verify_Presentation_1:
  "∀ x #NOW. (Restr_CI_IAE_Verify_Presentation_1( x ) @ #NOW) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_CI_IAE_Verify_Presentation_1( x ) @ #NOW) ⇒ (x = true)"
  */

restriction Restr_CI_IAE_Verify_Presentation_2:
  "∀ x #NOW. (Restr_CI_IAE_Verify_Presentation_2( x ) @ #NOW) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_CI_IAE_Verify_Presentation_2( x ) @ #NOW) ⇒ (x = true)"
  */

rule (modulo E) CI_IAE_Verify_Presentation[color=#fef9c3, role='CI']:
   [
   In( <'iae-followup', $CI, authSess, 'vp', $PI, sub, pkH_pres, vc, kbp> ),
   !CI_IAE_Pending( $CI, authSess, nonce ), !Pk_PI( $PI, pkPI ),
   Fr( ~atSecret )
   ]
  --[
  CI_Accepted_Presentation( $CI, authSess, pkH_pres, sub, nonce ),
  OnlyOnceV( <'presented', authSess> ),
  Restr_CI_IAE_Verify_Presentation_1( verify(vc,
                                             prereqPayload($PI, sub, pkH_pres), pkPI)
  ),
  Restr_CI_IAE_Verify_Presentation_2( verify(kbp, kbPayload($CI, nonce),
                                             pkH_pres)
  )
  ]->
   [
   !CI_Authorized( $CI, authSess, aToken(~atSecret, authSess, $CI),
                   pkH_pres, sub, nonce
   ),
   Out( aToken(~atSecret, authSess, $CI) )
   ]

  /*
  rule (modulo AC) CI_IAE_Verify_Presentation[color=#fef9c3, role='CI']:
     [
     In( <'iae-followup', $CI, authSess, 'vp', $PI, sub, pkH_pres, vc, kbp> ),
     !CI_IAE_Pending( $CI, authSess, nonce ), !Pk_PI( $PI, pkPI ),
     Fr( ~atSecret )
     ]
    --[
    CI_Accepted_Presentation( $CI, authSess, pkH_pres, sub, nonce ),
    OnlyOnceV( <'presented', authSess> ),
    Restr_CI_IAE_Verify_Presentation_1( z ),
    Restr_CI_IAE_Verify_Presentation_2( z.1 )
    ]->
     [
     !CI_Authorized( $CI, authSess, aToken(~atSecret, authSess, $CI),
                     pkH_pres, sub, nonce
     ),
     Out( aToken(~atSecret, authSess, $CI) )
     ]
    variants (modulo AC)
    1. $CI   = $CI.26
       $PI   = $PI.27
       kbp   = kbp.30
       nonce = nonce.31
       pkH_pres
             = pkH_pres.32
       pkPI  = pkPI.33
       sub   = sub.34
       vc    = vc.35
       z     = verify(vc.35, <'prereq-vc', $PI.27, sub.34, pkH_pres.32>,
                      pkPI.33)
       z.1   = verify(kbp.30, <'kb-jwt', <'iar', $CI.26>, nonce.31>,
                      pkH_pres.32)
    
    2. $CI   = $CI.52
       $PI   = $PI.53
       kbp   = sign(<'kb-jwt', <'iar', $CI.52>, nonce.57>, x.102)
       nonce = nonce.57
       pkH_pres
             = pk(x.102)
       pkPI  = pkPI.59
       sub   = sub.60
       vc    = vc.61
       z     = verify(vc.61, <'prereq-vc', $PI.53, sub.60, pk(x.102)>, pkPI.59)
       z.1   = true
    
    3. $CI   = $CI.53
       $PI   = $PI.54
       kbp   = kbp.57
       nonce = nonce.58
       pkH_pres
             = pkH_pres.59
       pkPI  = pk(x.104)
       sub   = sub.61
       vc    = sign(<'prereq-vc', $PI.54, sub.61, pkH_pres.59>, x.104)
       z     = true
       z.1   = verify(kbp.57, <'kb-jwt', <'iar', $CI.53>, nonce.58>,
                      pkH_pres.59)
    
    4. $CI   = $CI.53
       $PI   = $PI.54
       kbp   = sign(<'kb-jwt', <'iar', $CI.53>, nonce.58>, x.103)
       nonce = nonce.58
       pkH_pres
             = pk(x.103)
       pkPI  = pk(x.104)
       sub   = sub.61
       vc    = sign(<'prereq-vc', $PI.54, sub.61, pk(x.103)>, x.104)
       z     = true
       z.1   = true
  */

restriction Restr_Victim_Present_VP_1:
  "∀ x #NOW. (Restr_Victim_Present_VP_1( x ) @ #NOW) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Victim_Present_VP_1( x ) @ #NOW) ⇒ (x = true)"
  */

rule (modulo E) Victim_Present_VP[color=#d1fae5, role='Holder']:
   [
   !Victim_PrereqVC( $Wid, $PI, sub, ~skH, pkH, vc ), !Pk_CI( CI, pkCI ),
   In( <presReqPayload(CI, nonce), sig> )
   ]
  --[
  Victim_Presented( $Wid, CI, pkH, sub, nonce ),
  Restr_Victim_Present_VP_1( verify(sig, presReqPayload(CI, nonce), pkCI) )
  ]->
   [ Out( <'vp', $PI, sub, pkH, vc, kbProof(CI, nonce, ~skH)> ) ]

  /*
  rule (modulo AC) Victim_Present_VP[color=#d1fae5, role='Holder']:
     [
     !Victim_PrereqVC( $Wid, $PI, sub, ~skH, pkH, vc ), !Pk_CI( CI, pkCI ),
     In( <<'openid4vp-request', CI, <'iar', CI>, nonce>, sig> )
     ]
    --[
    Victim_Presented( $Wid, CI, pkH, sub, nonce ),
    Restr_Victim_Present_VP_1( z )
    ]->
     [
     Out( <'vp', $PI, sub, pkH, vc, sign(<'kb-jwt', <'iar', CI>, nonce>, ~skH)
          >
     )
     ]
    variants (modulo AC)
    1. CI    = CI.21
       nonce = nonce.22
       pkCI  = pkCI.23
       sig   = sig.25
       z     = verify(sig.25,
                      <'openid4vp-request', CI.21, <'iar', CI.21>, nonce.22>, pkCI.23)
    
    2. CI    = CI.55
       nonce = nonce.56
       pkCI  = pk(x.105)
       sig   = sign(<'openid4vp-request', CI.55, <'iar', CI.55>, nonce.56>,
                    x.105)
       z     = true
  */

rule (modulo E) Hon_Client_Init[color=#bfdbfe, role='Wallet']:
   [ !StoredVictimHolderKey( $Wid, ~skH, pkH ), Fr( ~sid ) ]
  --[ Hon_Init( $Wid, $CI, ~sid ) ]->
   [ Hon_St1( $Wid, $CI, ~sid, ~skH, pkH ), Out( <'iae-init', $CI> ) ]

  /* has exactly the trivial AC variant */

restriction Restr_Hon_Client_Followup_1:
  "∀ x #NOW. (Restr_Hon_Client_Followup_1( x ) @ #NOW) ⇒ (x = true)"
  // safety formula

  /*
  expanded formula:
  "∀ x #NOW. (Restr_Hon_Client_Followup_1( x ) @ #NOW) ⇒ (x = true)"
